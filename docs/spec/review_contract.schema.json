    "case_id",
    "case_revision_id",
    "episode_id",
    "scope",
    "documents",
    "client_statements",
    "evidence",
    "areas",
    "connections",
    "measurements",
    "monitoring_series",
    "samples",
    "claims",
    "hypotheses",
    "proposed_actions",
    "references",
    "questions",
    "findings",
    "release",
