      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule_pack_version": {
          "type": "string",
          "minLength": 1
        },
        "reference_snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "input_snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "rule_pack_version",
        "reference_snapshot_id",
        "prompt_version",
        "model_version",
        "input_snapshot_sha256",
        "run_id"
