  "$defs": {
    "Anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_version_id": {
          "type": "string",
          "minLength": 1
        },
        "pdf_page_index_1based": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "printed_page_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "paragraph_or_table_anchor": {
          "type": [
            "string",
            "null"
          ]
        },
        "bbox_normalized": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 4,
              "maxItems": 4
            }
          ]
        },
        "exact_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "extraction_method": {
          "type": "string",
          "enum": [
            "native_text",
            "ocr",
            "image_observation",
            "client_entry",
            "reviewer_entry"
          ]
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "document_version_id",
        "pdf_page_index_1based",
        "printed_page_label",
        "paragraph_or_table_anchor",
        "bbox_normalized",
        "exact_text",
        "extraction_method",
        "quality_flags"
      ]
    },
    "Document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "assessment",
            "agreement",
            "laboratory",
            "protocol",
            "photographs",
            "monitoring",
            "correspondence",
            "other"
