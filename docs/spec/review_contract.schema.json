  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "case_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Document"
      }
    },
    "client_statements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClientStatement"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Evidence"
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Area"
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Connection"
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Measurement"
      }
    },
    "monitoring_series": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Monitoring"
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Sample"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Claim"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Hypothesis"
      }
    },
    "proposed_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Action"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Reference"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Question"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "release": {
      "$ref": "#/$defs/Release"
    },
