{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/environmental-review/review-contract-v0.1.schema.json",
  "title": "Environmental review case snapshot version 0.1",
  "description": "Proposed interchange schema; server must also enforce referential integrity, authorization, rights, state guards, and semantic requirements.",
